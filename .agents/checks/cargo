#!/bin/sh
# cargo with the Ghostty pane engine where zig 0.15 is installed, and --no-default-features (vt100 only) where it is not.
PATH=/opt/homebrew/opt/zig@0.15/bin:$PATH
export PATH
case "$(zig version 2>/dev/null)" in
0.15.*) exec cargo "$@" ;;
esac
sub=$1
shift
exec cargo "$sub" --no-default-features "$@"
